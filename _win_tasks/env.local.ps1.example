# env.local.ps1.example - Template for machine-local toolchain config.
# Copy to _win_tasks/env.local.ps1 (gitignored, never commit) and set your real paths.
# Dot-sourced by preflight.ps1 / start-backend.ps1; overrides default resolution (JAVA_HOME/MAVEN_HOME -> PATH).
# Keep ASCII-only: Windows PowerShell 5.1 reads BOM-less files as ANSI and may corrupt UTF-8 lines.
$JavaExe = 'X:\path\to\jdk-17\bin\java.exe'
$MvnCmd  = 'X:\path\to\apache-maven\bin\mvn.cmd'
