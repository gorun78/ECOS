# ECOS E2E 工程环境变量模板：复制为 ecos-tests/.env（已 gitignore）后填写
# 凭据禁止写入用例与本文档，只从 ecos-tests/.env 或进程环境变量读取。
# 本机开发账号/密码见 .trae/rules/开发环境登录凭据.md（仅限本机开发环境）。

ECOS_USER=
ECOS_PASS=

# 后端 gateway（API 面用例与浏览器免登录 token 的来源）
ECOS_API=http://localhost:8080

# 前端（vite dev :3000 或 BFF），e2e 用例的 baseURL
ECOS_BASE=http://localhost:3000

# 场景工作台 live 用例的数据前置（dev 演示数据只有 sc_ent2_* / sc_entmgmt）：
# 有蓝图/有认知绑定的场景；不填则用例回落到 sc001（本机演示库不存在会红）。
ECOS_E2E_SCENARIO_ID=
# 无蓝图场景（用于 Blueprint 空态用例）；可用任意新建场景（无蓝图版本）。
ECOS_E2E_EMPTY_SCENARIO_ID=
