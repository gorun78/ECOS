# ═══════════════════════════════════════════════════════════════════
# ECOS 前端 (ecos_frontend) 运行时环境变量模板
# 拷贝为 .env 或 .env.local 填空使用。🔴 不要提交真实密钥到 git。
#
# 架构依据：架构铁律 v1.6 §0.3.1 + ADR-10 (gateway-only external access)
# 生产：GATEWAY_URL 必填
# 开发：默认走 gateway；仅本文件 ECOS_LOCAL_DIRECT_SERVICE_PROXY=true
#      时才允许 BFF 对 datanet/workspace/aiming 三个 service 端口直连
# ═══════════════════════════════════════════════════════════════════

# ── 必选：gateway 唯一外部入口（🔴 生产必填；开发 default 即穿透此变量）──
GATEWAY_URL=http://localhost:8080

# ── BFF 直连 service 开关（ADR-10 / PMO-B） ──
# 🔴 默认 false = 生产配置。所有 /api/* 一律转发 GATEWAY_URL，
#    DATANET_URL/WORKSPACE_URL/AIMING_URL 即便配了也被 BFF 忽略。
# 置 true 仅用于本地调试某个但未部署 gateway 路由的 service，
# 启动时会打 [BFF] ECOS_LOCAL_DIRECT_SERVICE_PROXY=true warn 日志
# 并触发 5 类前缀定向直连。
ECOS_LOCAL_DIRECT_SERVICE_PROXY=false

# ── 以下三个仅在 ECOS_LOCAL_DIRECT_SERVICE_PROXY=true 时消费 ──
# 需要 gateway 未部署的 service 路由物理上独立可达。生产禁配意外值。
DATANET_URL=http://localhost:18082
WORKSPACE_URL=http://localhost:18090
AIMING_URL=http://localhost:18084

# ── 其它开发态变量 ──
PORT=3000
# 兼容旧 /api/audit-logs 的特殊兜底端点（sysman 单体 /sys-man 代理，
# 参 server.ts /api/audit-logs 实现）；后端没迁移前保留。
BACKEND_URL=http://localhost:8081