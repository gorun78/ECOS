<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>databridge-v2</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>gateway</artifactId>
    <packaging>jar</packaging>
    <name>ECOS Gateway</name>
    <description>ECOS 统一入口 — Spring Boot MVC 应用，导入全部业务模块，暴露 /api/* 端点</description>

    <dependencies>
        <!-- WebSocket -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Jackson JSR310 (Java 8 time serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- Security Engine (安全引擎 — ABAC/审计/脱敏/数据权限/安全配置/策略引擎) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>security-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Ontology Engine (本体引擎 — 本体设计器/工作流/图服务) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ontology-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- AI Engine (AI引擎 — Agent/Mesh/NLQ/Prompt/诊断) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ai-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Cognitive Engine (认知引擎 — World Model/因果推理/仿真/优化) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>cognitive-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Knowledge Engine (知识引擎 — KG/专家规则/RAG/图谱同步) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>kb-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Data Engine (数据引擎 — 数据目录/数据源/元数据/分类) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>data-engine-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Sys-Man Impl (IAM/组织/角色/权限/审计/ABAC/数据安全策略) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-boot</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Runtime Security (KMS/策略引擎/ABAC/合规/数据权限) -->

        <!-- Runtime 子模块 -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-monitor</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-task</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Workspace (Object Runtime / Ontology / Workflow — 从 P3 迁移) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>workspace-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Domain Modules (业务域模块 — 从 P3 迁移) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>buszhi-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- PMO-09 (2026-09-14): 移除 portal-impl/market-impl/worldmodel-impl 幽灵依赖。
             三者已在阶段 5 被 workspace/buszhi 吸收，gateway 源码无任何对应 import；
             原注释 "旧JAR兼容依赖 (构建时跳过, 运行时从.m2取)" 在空 .m2 环境会直接解析失败。 -->
        <!-- M0 改造 (2026-09-01): 删除 cognitive-impl 依赖。
             这是 pre-existing C1 模块源码已删, 仅存 .m2 stale JAR; ai-engine 的 CognitiveService/
             CognitiveController 已 stub (引用 0), gateway excludeFilters 已 exclude;
             真实认知能力在第 54 行 cognitive-engine-impl (cognitive-engine 引擎层)。
             跟踪 08-产品化重构方案/04 C1-Cognitive-重复-impl (Wave-2 ai 重写)。 -->
        <!-- Flyway DB Migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Spring Boot Web (Tomcat) — 替代 Spring Cloud Gateway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI (WebMvc 兼容) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JetBrains Annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
        </dependency>

        <!-- P3-4 数字孪生: Moquette 嵌入式 MQTT Broker -->
        <dependency>
            <groupId>io.moquette</groupId>
            <artifactId>moquette-broker</artifactId>
            <version>0.17</version>
        </dependency>

        <!-- P3-4 数字孪生: Eclipse Paho MQTT Client -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- P3-4 数字孪生: Eclipse Milo OPC-UA Server -->
        <dependency>
            <groupId>org.eclipse.milo</groupId>
            <artifactId>sdk-server</artifactId>
            <version>0.6.12</version>
        </dependency>

        <!-- P3-5 OpenTelemetry SDK -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.semconv</groupId>
            <artifactId>opentelemetry-semconv</artifactId>
            <version>1.27.0-alpha</version>
        </dependency>

        <!-- P3-1 MinIO SDK -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.10</version>
        </dependency>

        <!-- Caffeine Cache (B3/B5/A12: 内存泄漏修复 + 配额缓存) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- P2-13 Spring AOP (TokenMeter Aspect) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- P2-13 Hermes Engine (LLM Gateway, Agent Scheduler) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>llm-gateway</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- ArchUnit test dependency (A1-2: DcchengRemovalGuard) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit5 (A1-2: DcchengRemovalGuard) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 详细设计-00 门禁测试：MockHttpServletRequest/Response (TrustHeaderStrip/TraceId/...) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 详细设计-00 EditionProfileGuardTest：读取三档 profile yml -->
        <!--
          Note (2026-10-02 GATE-C 复核): 此前 <scope>test</scope> 会 shadow 掉 spring-boot
          传递进来的 compile 版 snakeyaml，导致 spring-boot fat-jar 里 snakeyaml 完全缺失,
          gateway 起动时报 "snakeyaml was not found on the classpath"（IllegalStateException
          at Application.environmentPrepared）。改为 compile 以恢复传递路径。
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- A+4: infrastructure access (git/minio/logging/i18n/alert migrated from runtime-core) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-access</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.chinacreator.gzcm.gateway.GatewayApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
