<?xml version="1.0" encoding="UTF-8"?>
<!-- 详细设计-00 W08: traceId 贯穿日志。pattern 中 [%X{traceId:-}] 读 MDC
     （由 gateway RequestContextFilter / 各 service HeaderAuthInterceptor 注入），全链路不断链。 -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%X{traceId:-NOID}] %-5level[%thread] %logger{40} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 详细设计-06 F06-08：Agent Loop 结构化行独立文件通道。
         ECOS_AGENT_LOOP logger 只写固定格式行（回放读取端 AgentLoopLogSource 按
         ${LOG_PATH}/agent-loop*.log 检索），故 pattern 只带 ISO 时间戳 + 原文，禁前缀噪声。
         滚动文件名必须保持纯文本（.gz 历史段不可回放）；目录单一来源 = logging.file.path（logback 侧同名 LOG_PATH）。 -->
    <appender name="AGENT_LOOP" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/agent-loop.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/agent-loop.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="ECOS_AGENT_LOOP" level="INFO" additivity="false">
        <appender-ref ref="AGENT_LOOP"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.chinacreator.gzcm" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
