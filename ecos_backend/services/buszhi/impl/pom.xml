<?xml version="1.0" encoding="UTF-8"?>
<!--
  PMO-49 P8-B 配套: 顶层 buszhi/ 已物理迁入 services/buszhi/impl/。
  本 pom 是 buszhi 聚合 pom (packaging=pom, artifactId=buszhi), buszhi-impl 子模块引用 parent=com.chinacreator.gzcm:buszhi:1.0.0-SNAPSHOT。
  注意: services/buszhi/ 是独立 service jar (buszhi-service), 与 services/buszhi/impl/ 不同。
  历史: 顶层 buszhi/ 与 services/buszhi/impl/ 二选一不存在导致 root pom <module>services/buszhi/impl</module> 解析失败, 现已物理移动使二者合并, 保留原目录结构。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>databridge-v2</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>buszhi</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>buszhi-impl</module>
    </modules>
</project>