<?xml version="1.0" encoding="UTF-8"?>
<sqlMap namespace="RolePermission">
    <insert id="insertRolePermission">
        INSERT INTO TD_ROLE_PERMISSION ("ROLE_ID", "PERMISSION_ID", "CREATED_TIME", "CREATED_BY")
        VALUES (#[roleId], #[permissionId], now(), 'system')
    </insert>

    <delete id="deleteRolePermission">
        DELETE FROM TD_ROLE_PERMISSION WHERE "ROLE_ID" = #[roleId] AND "PERMISSION_ID" = #[permissionId]
    </delete>

    <select id="listRolePermissions">
        SELECT "ROLE_ID" as role_id, "PERMISSION_ID" as permission_id FROM TD_ROLE_PERMISSION WHERE "ROLE_ID" = #[roleId]
    </select>
</sqlMap>
