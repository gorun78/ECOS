<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>ontology-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ontology-engine-impl</artifactId>
    <packaging>jar</packaging>
    <name>ECOS Ontology Engine :: Impl</name>

    <dependencies>
        <!-- Ontology Engine API -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ontology-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- dccheng-api/impl + worldmodel-impl: 阶段 5 已吸收 —
             dccheng→自身 (cognitive 内部吸收), worldmodel→buszhi
             (源码已 0 import com.chinacreator.gzcm.{dccheng,worldmodel},
              pom 只是历史残留 dependency)。Wave-10 CI root-cause. -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>buszhi-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring JDBC (for JdbcTemplate healthCheck) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- JSON 序列化/反序列化（parse 事件的 nodes/edges 存储） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Spring AOP (for OntologySecurityInterceptor) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- JSqlParser 4.9 — 本体血缘 SQL 解析（PMO-52 T2: 自实现字段级解析，
             版本与 data-engine-impl 对齐。架构铁律 2.1 不引用其他 engine-impl 类，
             故该模块对 data-engine-api 的血缘依赖不再需要，予以移除） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.9</version>
        </dependency>

        <!-- Lombok (SQLLineageRequest / LineageParseResponse 等 DTO 使用 @Data，
             跟随 data-engine-impl 版本 1.18.36 与 Spring Boot 3.2.2 BOM 对齐) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
            <scope>provided</scope>
        </dependency>

        <!-- Runtime Event (统一事件总线 — EventBusService 审计走 Kafka ecos.audit，
             符合架构铁律 §2.4 #5 + §2.5 公共底座，禁止引擎内自建 KafkaTemplate) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-event</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- SysMan (system config, etc.) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
            <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>
</project>
