        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ontology-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- dccheng-api/impl + worldmodel-impl: 阶段 5 已吸收 —
             dccheng→自身 (cognitive 内部吸收), worldmodel→buszhi
             (源码已 0 import com.chinacreator.gzcm.{dccheng,worldmodel},
