<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>ai-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-engine-impl</artifactId>
    <packaging>jar</packaging>
    <name>ECOS Cognitive Engine :: Impl</name>

    <dependencies>
        <!-- Cognitive Engine API -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ai-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Aimod Impl -->

        <!-- DcCheng API + Impl -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>dccheng-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>dccheng-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- M0-P0 改造 (2026-09-01): 删除 cognitive-api/cognitive-impl 依赖。
             这是 pre-existing C1 类 (CognitiveService/CognitiveController 引用),
             已在 13 模块基线删除 (旧 JAR 仍在 ~/.m2 stale 但不项目构建)。
             真实认知能力走 cognitive-engine (com.chinacreator.gzcm.engine.cognitive2.*),
             未来 ai-engine 的 v2 Controller 改成依赖 cognitive-engine-api。
             关联 08/04 C1-Cognitive-重复-impl 跟踪 Wave-2 ai。 -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>cognitive-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <optional>true</optional> <!-- Wave-2 ai 重写后启用, 当前 stub 不用 -->
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring JDBC (for JdbcTemplate healthCheck) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SysMan (system config) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Agent Service -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>agent-service</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Ontology Engine API (ExtractedSubGraph, ExtractedEntity, etc.) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ontology-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- KB Engine API (KnowledgeGraphService) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>kb-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- LLM Gateway (LLMGatewayService for LLM calls) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>llm-gateway</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Runtime Task (全局任务中心) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-task</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
            <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Wave-5.4 T-19: per-module jacoco CLASS 0.40 floor — 强制 ai-engine-impl per-class instruction 40%
                 (5 engine per-module 0.40, root bundle 0.05 兜底; skip=false 默认强 enforce) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>per-module-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.perModuleCheck.skip}</skip>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.chinacreator.gzcm.engine.ai.service.ToolCall</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.LLMProvider</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentCircuitBreaker</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentLoopResult</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.MemoryExtractor</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentSessionService</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.Message</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.KnowledgeGraphService</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.entity.KnowledgeNode</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.entity.KnowledgeEdge</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
