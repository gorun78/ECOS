<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>ai-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-engine-impl</artifactId>
    <packaging>jar</packaging>
    <name>ECOS AI Engine :: Impl</name>

    <dependencies>
        <!-- AI Engine API -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ai-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Aimod Impl -->

        <!-- PMO-09 (2026-09-14): 移除 dccheng-api/dccheng-impl 幽灵依赖。
             reactor 中 services/dccheng 仅产出 dccheng-service 单 jar (不产 -api/-impl artifact)；
             源码中无任何 import com.chinacreator.gzcm.dccheng.*，AGENTS.md 依赖清单也无 dccheng。 -->

        <!-- M0-P0 改造 (2026-09-01): 删除 cognitive-api/cognitive-impl 依赖。
             这是 pre-existing C1 类 (CognitiveService/CognitiveController 引用),
             已在 13 模块基线删除 (旧 JAR 仍在 ~/.m2 stale 但不项目构建)。
             真实认知能力走 cognitive-engine (com.chinacreator.gzcm.engine.cognitive2.*),
             未来 ai-engine 的 v2 Controller 改成依赖 cognitive-engine-api。
             关联 08/04 C1-Cognitive-重复-impl 跟踪 Wave-2 ai。 -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>cognitive-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <optional>true</optional> <!-- Wave-2 ai 重写后启用, 当前 stub 不用 -->
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok (PipelineNodeTraceVO 使用 @Getter/@Setter/@NoArgsConstructor, 版本由 Spring Boot BOM 管理) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring JDBC (for JdbcTemplate healthCheck) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SysMan (system config) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Ontology Engine API (ExtractedSubGraph, ExtractedEntity, etc.) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>ontology-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- KB Engine API (KnowledgeGraphService) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>kb-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- LLM Gateway (LLMGatewayService for LLM calls) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>llm-gateway</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Runtime Task (全局任务中心) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-task</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- 详细设计-06 F06-03：护栏裁决审计唯一出口 = runtime-event EventBusService → Kafka ecos.audit
             （铁律 §2.5-7 禁业务侧自建 KafkaTemplate；§2.4-5 审计发出失败 = 裁决整体失败） -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-event</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
            <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 详细设计-06 F06-22（P-1 测试底座）：@SpringBootTest 薄切片 + TestRestTemplate
             依赖（X-87 反虚假验收：本模块 0 @SpringBootTest 必须先补齐 —— 见
             AiTestHarnessSmokeTest#springBootTestSliceBootsInBothModes）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Wave-5.4 T-19: per-module jacoco CLASS 0.40 floor — 强制 ai-engine-impl per-class instruction 40%
                 (5 engine per-module 0.40, root bundle 0.05 兜底; skip=false 默认强 enforce) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>per-module-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.perModuleCheck.skip}</skip>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.chinacreator.gzcm.engine.ai.service.ToolCall</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.LLMProvider</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentCircuitBreaker</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentLoopResult</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.MemoryExtractor</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.AgentSessionService</include>
                                        <include>com.chinacreator.gzcm.engine.ai.service.Message</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.KnowledgeGraphService</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.entity.KnowledgeNode</include>
                                        <include>com.chinacreator.gzcm.engine.ai.agent.mesh.knowledge.entity.KnowledgeEdge</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2026-10-11 F02-15 收口批次实测：surefire 默认 includes 只认
                 Test*/*Test/*Tests/*TestCase，本模块三个 *IT 冻结验收类
                 （ScenarioToolInvocationIT / CitationInducementIT / WAgentGoalControllerIT）
                 从未被 mvn test 实跑过 —— 属假绿面。此处在本模块补齐 IT 执行面
                 （默认四项 pattern 必须一并声明，显式 includes 会覆盖默认值）。
                 其余模块的 *IT 登记为后续批次缺口，见补充详设 §19.6。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
