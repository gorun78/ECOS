<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chinacreator.gzcm</groupId>
        <artifactId>security-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>security-engine-impl</artifactId>
    <packaging>jar</packaging>
    <name>ECOS Security Engine :: Impl</name>

    <dependencies>
        <!-- Security Engine API -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>security-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

                <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-core</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
<!-- Sys-Man API (for IAM context, security model, audit, ABAC interfaces) -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- sysman-impl: provided scope 打破循环（编译期可见，不传递依赖） -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>sysman-impl</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- runtime-access: database/util 已迁入 -->
        <dependency>
            <groupId>com.chinacreator.gzcm</groupId>
            <artifactId>runtime-access</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Caffeine 本地缓存（B2: 决策缓存） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring JDBC (for JdbcTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
            <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Wave-5.4 T-19: per-module jacoco CLASS 0.40 floor (5 engine impl per-class instruction 40% 估阶 floor,
                 替代 root bundle 0.05 更精细; skip=false 默认强制, 大代码 class 缺 test 会 verify fail) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>per-module-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.perModuleCheck.skip}</skip>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.chinacreator.gzcm.engine.security.SecurityEngineImpl</include>
                                        <include>com.chinacreator.gzcm.engine.security.controller.DataMaskingController</include>
                                        <include>com.chinacreator.gzcm.engine.security.controller.DataPermissionController</include>
                                        <include>com.chinacreator.gzcm.engine.security.controller.CryptoAuditController</include>
                                        <include>com.chinacreator.gzcm.engine.security.controller.RlsController</include>
                                        <include>com.chinacreator.gzcm.engine.security.controller.SecurityEngineStatusController</include>
                                        <include>com.chinacreator.gzcm.engine.security.policy.engine.impl.PDPImpl</include>
                                        <include>com.chinacreator.gzcm.engine.security.abac.service.impl.AbacPermissionCheckerImpl</include>
                                        <include>com.chinacreator.gzcm.engine.security.abac.cache.InMemoryAbacPolicyCacheService</include>
                                        <include>com.chinacreator.gzcm.engine.security.service.AuditHashChainService</include>
                                        <include>com.chinacreator.gzcm.engine.security.service.DataMaskingService</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
