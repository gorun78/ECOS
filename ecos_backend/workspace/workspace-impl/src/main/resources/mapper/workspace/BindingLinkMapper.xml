<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinacreator.gzcm.workspace.mapper.BindingLinkMapper">

    <resultMap id="LinkEdgeMap" type="com.chinacreator.gzcm.workspace.scenario.LinkEdge">
        <constructor>
            <arg column="source_binding_id" javaType="java.lang.String"/>
            <arg column="target_binding_id" javaType="java.lang.String"/>
            <arg column="link_type" javaType="com.chinacreator.gzcm.workspace.scenario.EdgeType"/>
        </constructor>
    </resultMap>

    <select id="selectByScenario" resultMap="LinkEdgeMap">
        SELECT source_binding_id, target_binding_id, link_type
        FROM #{schema}.ecos_scenario_binding_edge
        WHERE scenario_id = #{scenarioId} AND is_deleted = 0
    </select>

    <select id="countByScenarioAndType" resultType="int">
        SELECT COUNT(1)
        FROM #{schema}.ecos_scenario_binding_edge
        WHERE scenario_id = #{scenarioId} AND link_type = #{linkType} AND is_deleted = 0
    </select>

</mapper>
